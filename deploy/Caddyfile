{$CRASHLAB_DEMO_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
    @health path /healthz
    handle @health {
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        basic_auth {
            judge {$CRASHLAB_JUDGE_PASSWORD_HASH}
        }
        reverse_proxy 127.0.0.1:8765
    }
}
