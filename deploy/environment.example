# Server-side file: /etc/agent-crashlab/runtime.env (root:root, mode 0600).
# Never commit a populated copy or send it to the browser.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
CRASHLAB_PUBLIC_ORIGIN=https://YOUR_DEMO_HOST
CRASHLAB_MAX_LIVE_RUNS=30
PYTHONDONTWRITEBYTECODE=1
TMPDIR=/var/lib/agent-crashlab/tmp
